# Northflank deployment example for ELVIR backend.
# Copy these values into the Northflank service environment UI.

ENV=prod
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=12

LOG_LEVEL=INFO
RATE_LIMIT_TRUST_X_FORWARDED_FOR=true

APP_BASE_URL=https://elvir-demo.vercel.app
CORS_ORIGINS=https://elvir-demo.vercel.app

LIVEAVATAR_API_KEY=
LIVEAVATAR_API_BASE=https://api.liveavatar.com/v1
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
# TTS language sent to LiveAvatar: es (default) or en for English demos.
LIVEAVATAR_LANGUAGE=es
# Leave empty if contexts are resolved per template from the database.
LIVEAVATAR_CONTEXT_ID=
LIVEAVATAR_WEBHOOK_SECRET=

# Prefer S3-compatible storage if you need files to survive redeploys.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=
