# =============================================================================
# ELVIR Backend - Variables de entorno
# Copiar a .env y ajustar valores. En producción, SECRET_KEY es OBLIGATORIO.
# =============================================================================

# Base de datos (PostgreSQL)
# Con Docker: docker compose up -d
DATABASE_URL=postgresql://elvir:elvir@localhost:5432/elvir

# JWT - OBLIGATORIO en producción: generar con `openssl rand -hex 32`
# No usar el valor por defecto en producción.
SECRET_KEY=elvir-dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# URL base del frontend (para enlaces de activación de cuenta)
APP_BASE_URL=http://localhost:4200

# LiveAvatar (Context Dinámico) - Requerido para simulaciones reales
# Obtener credenciales en https://liveavatar.com
# Sin estas variables, la simulación muestra un placeholder.
# LIVEAVATAR_API_KEY=tu-api-key
# LIVEAVATAR_CONTEXT_ID=uuid-del-contexto
# LIVEAVATAR_AVATAR_ID=uuid-del-avatar
# LIVEAVATAR_VOICE_ID=uuid-de-la-voz
# LIVEAVATAR_API_BASE=https://api.liveavatar.com/v1
