# Copiar a .env y ajustar. No commitear secretos reales.
DATABASE_URL=postgresql://elvir:elvir@localhost:5432/elvir
# En ENV=prod se exige longitud >= 32 y distinto del valor por defecto de desarrollo.
SECRET_KEY=generar-con-openssl-rand-hex-32
# Vida del JWT (y max_age de cookies de sesión), en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENV=dev
# Longitud mínima de contraseña (activación y cambio). En ENV=prod debe ser >= 12 (validado al arrancar).
# PASSWORD_MIN_LENGTH=12
# Nivel: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Vacío o ausente: JSON en una línea solo si ENV=prod. true/false fuerza formato.
# LOG_JSON=
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Intentos de login por IP y minuto (slowapi). Ajustar en producción.
LOGIN_RATE_LIMIT=5/minute
# Activación de cuenta (validar token / completar registro) por IP.
ACTIVATE_VALIDATE_RATE_LIMIT=30/minute
ACTIVATE_ACCOUNT_RATE_LIMIT=10/minute
# Cambio de contraseña / email (por IP, con sesión).
AUTH_ACCOUNT_CHANGE_RATE_LIMIT=15/minute
# Subidas: foto de perfil (/auth/me/photo) y material staff (/upload).
PROFILE_PHOTO_RATE_LIMIT=30/minute
STAFF_UPLOAD_RATE_LIMIT=40/minute
# Rutas /api/v1/admin/* (por IP).
ADMIN_API_RATE_LIMIT=120/minute
# Límite por defecto para rutas /api/v1/* sin @limiter propio (por IP).
DEFAULT_API_RATE_LIMIT=300/minute
# Observabilidad / proxy: detrás de nginx o ingress, poner true para que el rate limit use la IP real
# (primer valor de X-Forwarded-For). No activar si el cliente llega directo al API (falsificación de cabecera).
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false

# --- LiveAvatar (simulación con avatar real; si falta o hay IDs de prueba, verás iframe placeholder) ---
# El seed guarda en BD los marcadores ctx-elvir-dinamico, avatar-default, voice-default: NO son válidos para la API.
# Obtén context_id, avatar_id y voice_id reales en el panel de LiveAvatar y ponlos aquí (o actualiza simulation_templates).
# LIVEAVATAR_API_KEY=
# LIVEAVATAR_CONTEXT_ID=
# LIVEAVATAR_AVATAR_ID=
# LIVEAVATAR_VOICE_ID=
# LIVEAVATAR_LANGUAGE=es
# LIVEAVATAR_API_BASE=https://api.liveavatar.com/v1
# Opcional: POST /sessions/evaluation con cabecera X-ELVIR-Webhook-Secret
# LIVEAVATAR_WEBHOOK_SECRET=
# Almacenamiento de ficheros (material, audio, fotos): local = carpeta uploads/ (default); s3 = bucket S3-compatible (MinIO, R2, AWS).
# STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=
