# Base de datos (SQLite por defecto)
# DATABASE_URL=sqlite:///./elvir.db

# JWT - Cambiar en producción
# SECRET_KEY=elvir-dev-secret-change-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Orígenes permitidos (separados por coma)
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# URL base del frontend (para activation_url)
# APP_BASE_URL=http://localhost:4200

# LiveAvatar (Context Dinámico) - Requerido para simulaciones reales
# Obtener credenciales en https://liveavatar.com
# Sin estas variables, la simulación muestra un placeholder.
# LIVEAVATAR_API_KEY=tu-api-key
# LIVEAVATAR_CONTEXT_ID=uuid-del-contexto  # Contexto que se actualiza con PATCH
# LIVEAVATAR_AVATAR_ID=uuid-del-avatar     # Opcional, default: "default"
# LIVEAVATAR_VOICE_ID=uuid-de-la-voz      # Opcional, default: "default"
# LIVEAVATAR_API_BASE=https://api.liveavatar.com/v1  # Por defecto
